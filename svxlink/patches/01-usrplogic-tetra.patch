+/*
+ * TETRA extensions (DMO2TMO SVXBridge)
+ *
+ * The USRP partner (the TETRA bridge) puts the ISSI of the talking TETRA
+ * subscriber into the DMR-ID field of the TLV metadata and its callsign into
+ * the callsign field. From that we publish TetraLogic compatible state
+ * events (Qso:info, TetraUsers:info, Register:info) so that the ISSI is
+ * known on the reflector network.
+ *
+ * The other direction uses the same field: if a remote TETRA node reports
+ * its talker via Qso:info, or the reflector names the talking node via
+ * Reflector:talker_start, that information goes into the metadata we send
+ * to the USRP partner at the beginning of a transmission.
+ *
+ * SDS travel as USRP TEXT messages with the prefix "SDS:" followed by a JSON
+ * object, in both directions.
+ */
+
+uint32_t UsrpLogic::issiFromTsi(const std::string& tsi)
+{
+  std::string digits;
+  for (char c : tsi)
+  {
+    if (isdigit(static_cast<unsigned char>(c))) digits += c;
+  }
+  if (digits.empty()) return 0;
+    // a full TSI is MCC(4)+MNC(5)+ISSI(8) - only the ISSI fits into 24 bit
+  if (digits.length() > 8) digits = digits.substr(digits.length() - 8);
+  unsigned long v = strtoul(digits.c_str(), nullptr, 10);
+  return (v > 0xffffff) ? 0 : static_cast<uint32_t>(v);
+} /* UsrpLogic::issiFromTsi */
+
+
+void UsrpLogic::publishQso(bool active)
+{
+  if (m_rx_issi == 0) return;
+
+  announceTetraUser(m_rx_issi, m_rx_call);
+
+  Json::Value qsoinfo(Json::objectValue);
+  qsoinfo["qso_active"] = active;
+  qsoinfo["gateway"] = m_callsign;
+  qsoinfo["dest_issi"] = m_last_tg > 0 ? m_last_tg : m_selected_tg;
+  qsoinfo["last_activity"] = static_cast<Json::UInt>(time(NULL));
+  qsoinfo["qso_members"] = m_rx_call;
+  if (active)
+  {
+    qsoinfo["active_issi"] = std::to_string(m_rx_issi);
+  }
+  else
+  {
+    qsoinfo["last_talker"] = std::to_string(m_rx_issi);
+  }
+  qsoinfo["message"] = "Qso:info";
+  publishInfo("Qso:info", qsoinfo);
+
+  stringstream ss;
+  ss << "tetra_qso " << (active ? "start " : "stop ") << m_rx_issi << " "
+     << (m_rx_call.empty() ? "-" : m_rx_call);
+  log(LOGINFO, ss.str());
+} /* UsrpLogic::publishQso */
+
+
+void UsrpLogic::announceTetraUser(uint32_t issi, const std::string& call)
+{
+  if (issi == 0 || call.empty()) return;
+  if (m_announced_issis.count(issi) > 0) return;
+  m_announced_issis.insert(issi);
+
+  Json::Value user(Json::objectValue);
+  user["id"] = std::to_string(issi);
+  user["tsi"] = std::to_string(issi);
+  user["call"] = call;
+  user["name"] = call;
+  user["mode"] = "TETRA";
+  user["idtype"] = "ISSI";
+  user["registered"] = true;
+  user["last_activity"] = static_cast<Json::UInt>(time(NULL));
+
+  Json::Value users(Json::arrayValue);
+  users.append(user);
+  publishInfo("TetraUsers:info", users);   // reflector: create the user
+  publishInfo("Register:info", users);     // reflector: gateway = this node
+} /* UsrpLogic::announceTetraUser */
+
+
+void UsrpLogic::handleSdsFromUsrp(const std::string& json)
+{
+  Json::CharReaderBuilder rbuilder;
+  std::unique_ptr<Json::CharReader> const reader(rbuilder.newCharReader());
+  std::string err;
+  Json::Value sds;
+  if (!reader->parse(json.c_str(), json.c_str() + json.size(), &sds, &err)
+      || !sds.isObject())
+  {
+    log(LOGERROR, "*** ERROR: SDS from USRP partner is no JSON: " + err);
+    return;
+  }
+
+  uint32_t src_issi = sds.get("source_issi", 0).asUInt();
+  std::string src_call = sds.get("source_call", "").asString();
+  std::string dest_call = sds.get("dest_call", "").asString();
+  std::string text = sds.get("text", "").asString();
+  if (text.empty()) return;
+
+  announceTetraUser(src_issi, src_call);
+
+  uint32_t ti = time(NULL);
+
+    // for the reflector status page (same layout as TetraLogic)
+  Json::Value sdsinfo(Json::objectValue);
+  sdsinfo["last_activity"] = ti;
+  sdsinfo["sendertsi"] = std::to_string(src_issi);
+  sdsinfo["type"] = 0;
+  sdsinfo["from"] = src_call;
+  sdsinfo["to"] = dest_call;
+  sdsinfo["receivertsi"] = "";
+  sdsinfo["gateway"] = m_callsign;
+  sdsinfo["message"] = "Sds:info";
+  publishInfo("Sds:info", sdsinfo);
+
+  if (!dest_call.empty())
+  {
+      // keys of the sender (TetraLogic) and of the receiver side, so both
+      // the current and a fixed TetraLogic can read it
+    Json::Value fwd(Json::objectValue);
+    fwd["dest_callsign"] = dest_call;
+    fwd["dest_call"] = dest_call;
+    fwd["sdsmessage"] = text;
+    fwd["sds_info"] = text;
+    fwd["source_call"] = src_call;
+    fwd["source_issi"] = std::to_string(src_issi);
+    fwd["gateway"] = m_callsign;
+    fwd["message"] = "ForwardSds:info";
+    publishInfo("ForwardSds:info", fwd);
+  }
+
+  log(LOGINFO, "tetra_sds " + std::to_string(src_issi) + " (" + src_call
+      + ") -> " + (dest_call.empty() ? "-" : dest_call) + ": " + text);
+} /* UsrpLogic::handleSdsFromUsrp */
+
+
+void UsrpLogic::sendTextToUsrp(const std::string& prefix,
+                               const Json::Value& value)
+{
+  Json::StreamWriterBuilder builder;
+  builder["commentStyle"] = "None";
+  builder["indentation"] = "";
+  std::string text = prefix + Json::writeString(builder, value);
+
+  UsrpMetaTextMsg usrp;
+  if (udp_seq++ > 0x7fff) udp_seq = 0;
+  ostringstream os;
+  if (!usrp.pack(os))
+  {
+    cerr << "*** ERROR[" << name() << "]: Failed to pack UDP Usrp message\n";
+    return;
+  }
+    // UsrpMetaTextMsg packs header + one meta byte; replace that byte by
+    // the text
+  std::string packet = os.str().substr(0, USRP_HEADER_LEN) + text;
+  ostringstream out;
+  out << packet;
+  sendUdpMessage(out);
+} /* UsrpLogic::sendTextToUsrp */
+
+
+void UsrpLogic::remoteReceivedPublishStateEvent(LogicBase *src_logic,
+    const std::string& event_name, const std::string& msg)
+{
+  if (event_name != "Qso:info" && event_name != "ForwardSds:info" &&
+      event_name != "Reflector:talker_start")
+  {
+    return;
+  }
+
+  Json::CharReaderBuilder rbuilder;
+  std::unique_ptr<Json::CharReader> const reader(rbuilder.newCharReader());
+  std::string err;
+  Json::Value v;
+  if (!reader->parse(msg.c_str(), msg.c_str() + msg.size(), &v, &err))
+  {
+    log(LOGERROR, "*** ERROR: parsing " + event_name + " (" + err + ")");
+    return;
+  }
+  if (v.isArray())
+  {
+    if (v.empty()) return;
+    v = v[0];
+  }
+
+  if (event_name == "Reflector:talker_start")
+  {
+    if (!m_remote_active || m_remote_call.empty())
+    {
+      m_remote_call = v.get("callsign", "").asString();
+      m_remote_active = true;
+    }
+  }
+  else if (event_name == "Qso:info")
+  {
+    if (v.get("gateway", "").asString() == m_callsign) return;
+    if (v.get("qso_active", false).asBool())
+    {
+      m_remote_issi = issiFromTsi(v.get("active_issi", "").asString());
+      std::string members = v.get("qso_members", "").asString();
+      if (!members.empty())
+      {
+        m_remote_call = members.substr(members.find_last_of(",") + 1);
+      }
+      m_remote_active = true;
+      stringstream ss;
+      ss << "remote tetra talker " << m_remote_issi << " " << m_remote_call;
+      log(LOGINFO, ss.str());
+        // already transmitting? then send the new talker data at once
+      if (ident) sendMetaMsg();
+    }
+  }
+  else if (event_name == "ForwardSds:info")
+  {
+    std::string dest = v.get("dest_call", v.get("dest_callsign", "")
+                              .asString()).asString();
+    std::string text = v.get("sds_info", v.get("sdsmessage", "")
+                              .asString()).asString();
+    std::string src = v.get("source_call", v.get("source", "")
+                              .asString()).asString();
+    if (dest.empty() || text.empty()) return;
+
+    Json::Value sds(Json::objectValue);
+    sds["dest_call"] = dest;
+    sds["text"] = text;
+    sds["source_call"] = src;
+    sds["source_issi"] = v.get("source_issi", "").asString();
+    sds["gateway"] = v.get("gateway", "").asString();
+    sendTextToUsrp("SDS:", sds);
+    log(LOGINFO, "forward sds " + src + " -> " + dest + ": " + text);
+  }
+} /* UsrpLogic::remoteReceivedPublishStateEvent */
+
