[GATEWAY]
GATEWAY_CALL=YY1ZZZ-RL
GATEWAY_COMMENT=City/Frequenzy
GATEWAY_ID=MCC199

GATEWAY_LAT=4816.82
GATEWAY_LON=01624.91

# GATEWAY      =NO
# DMO-REPEATER=YES
DMO_REPEATER=YES

[SVXREFLECTOR]
# UDP svxreflector connection via INTERNET
#
REFLECTOR_DNS=tetra-reflector.dyndns.org

# via HAMNET
#REFLECTOR_DNS=44.143.8.74

# LASTHEARD PORT
REFLECTOR_PORT=5220

[WEATHER]
CITY=City
ZIP=9999
COUNTRY=AT

[SYSTEM]
#Supported Hardware: CM5000 CM5000A MTM5400 MTM800e MTM800FuG MTP850S MTP850FuG SRG3900 
SYS_HARDWARE=MTM5400
SYS_SERPORT=/dev/ttyS0
SYS_SERBAUD=9600
SYS_CTOM_WAIT=3

SYS_DEBUG=0
